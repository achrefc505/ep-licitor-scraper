# SQL Server — base RAW (séparée de l'app)
DB_SERVER=(localdb)\mssqllocaldb
DB_NAME=EncheresPredict_Raw
DB_TRUSTED=yes
# Pour SQL Server avec login/password (sinon vide) :
# DB_USER=sa
# DB_PASSWORD=YourPwd

# SQL Server — base APPLICATIVE (lue par le frontend Angular via .NET)
APP_DB_SERVER=(localdb)\mssqllocaldb
APP_DB_NAME=EncheresPredict
APP_DB_TRUSTED=yes
# APP_DB_USER=
# APP_DB_PASSWORD=

# API ML pour calculer aiEstimate / confidence lors du sync
ML_API_URL=http://localhost:8000
ML_API_TIMEOUT=10

# Géocodage (adresse.data.gouv.fr) — gratuit, illimité, France
GEOCODER_URL=https://api-adresse.data.gouv.fr/search/
GEOCODER_TIMEOUT=10

# Scraping
SCRAPER_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
SCRAPER_DELAY_MIN=3.0
SCRAPER_DELAY_MAX=7.0
SCRAPER_TIMEOUT_MS=30000
SCRAPER_HEADLESS=true
SCRAPER_MAX_RETRIES=3

# Limites de prudence — IMPORTANT pour ne pas se faire bloquer
SCRAPER_MAX_PAGES_PER_RUN=20
SCRAPER_RESPECT_ROBOTS=true

# Logs
LOG_LEVEL=INFO
LOG_FILE=logs/scraper.log
